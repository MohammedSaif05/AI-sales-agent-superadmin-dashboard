# NestJS Backend API Base URL
# Backend server runs on port 3000 (see D:\AI-sales-agent-backend\.env)
# API prefix: /api/v1 (e.g. http://localhost:3000/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Note: The Super Admin Dashboard frontend runs on http://localhost:3001
# (CORS on the backend already allows http://localhost:3001)
